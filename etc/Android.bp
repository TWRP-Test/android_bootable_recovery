// TW_INCLUDE_LPDUMP start
prebuilt_bin {
    name: "lpdump.recovery",
    src: ":lpdump",
    filename: "lpdump",
    recovery: true,
}

cc_prebuilt_library {
    name: "liblpdump_interface-cpp.recovery",
    srcs: [":liblpdump_interface-cpp"],
    stem: "liblpdump_interface-cpp",
    shared_libs: [
        "libbinder",
        "libc++",
        "libcutils",
        "libutils",
    ],
    recovery: true
}

prebuilt_bin {
    name: "lpdumpd.recovery",
    src: ":lpdumpd",
    filename: "lpdumpd",
    required: [
        "liblpdump_interface-cpp.recovery",
        "libprotobuf-cpp-full.recovery",
    ],
    recovery: true,
}

prebuilt_bin {
    name: "bootctl.recovery",
    src: ":bootctl",
    filename: "bootctl",
    recovery: true,
}
// TW_INCLUDE_LPDUMP end

