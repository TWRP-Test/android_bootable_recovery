prebuilt_root {
    name: "vndservice_contexts.recovery",
    src: ":vndservice_contexts",
    filename: "vndservice_contexts",

    recovery: true,
    install_in_root: true,
}

// hwservicemanager
cc_prebuilt_binary {
    name: "hwservicemanager.recovery",
    srcs: [":hwservicemanager"],

    shared_libs: [
        "android.hidl.token@1.0",
        "libbase",
        "libc++",
        "libcrypto",
        "libcutils",
        "libhidl-gen-utils",
        "libhidlbase",
        "liblog",
        "libselinux",
        "libutils",
        "libvintf"
    ],
    init_rc: ["init/hwservicemanager.rc"],

    stem: "hwservicemanager",
    recovery: true
}

// vndservicemanager
cc_prebuilt_binary {
    name: "vndservicemanager.recovery",
    srcs: [":vndservicemanager"],
    
    shared_libs: [
        "libbase",
        "libbinder",
        "libc++",
        "libcutils",
        "liblog",
        "libselinux",
        "libutils"
    ],
    init_rc: ["init/vndservicemanager.rc"],

    stem: "vndservicemanager",
    recovery: true
}

// task_profiles
prebuilt_etc {
    name: "task_profiles.json.recovery",
    src: ":task_profiles.json",
    filename: "task_profiles.json",
    recovery: true,
}

// Android keystore2
prebuilt_bin {
    name: "keystore2.recovery",
    src: ":keystore2",
    init_rc: ["init/keystore2.rc"],
    filename: "keystore2",
    vintf_fragments: ["init/android.system.keystore2-service.xml"],
    recovery: true,
}

// Healthd
prebuilt_bin {
    name: "android.hardware.health@2.1-service.recovery",
    src: ":android.hardware.health@2.1-service",
    init_rc: ["init/android.hardware.health@2.1-service.rc"],
    filename: "android.hardware.health@2.1-service",
    required: ["android.hardware.health@2.1-impl.recovery"],
    recovery: true,
}

