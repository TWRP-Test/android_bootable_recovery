bootstrap_go_package {
    name: "soong-libtwrpminui_defaults",
    pkgPath: "bootable/recovery/twrpminui",
    deps: [
        "soong",
        "soong-android",
        "soong-cc"
    ],
    srcs: [
        "libtwrpminui_defaults.go",
        "../soong/makevars.go",
        "../soong/variables.go"
    ],
    pluginFor: ["soong_build"]
}

libtwrpminui_defaults {
    name: "libtwrpminui_defaults"
}

cc_library_shared {
    name: "libtwrpminui",
    defaults: ["libtwrpminui_defaults", "twrp_defaults", "twrp_cflags_defaults"],
    // Match current minui: DRM is a required backend on this Android branch.
    // TWRP: haptics/BoardConfig options are handled by the load hook.
    export_include_dirs: [
        "include",
    ],
    include_dirs: [
        "bootable/recovery",
        "bootable/recovery/twrpminui",
        "bootable/recovery/twrpinstall/include",
    ],
    srcs: [
        "graphics.cpp",
        "graphics_fbdev.cpp",
        "graphics_drm.cpp",
        "graphics_utils.cpp",
        "events.cpp",
        // TWRP: touch conversion and vibrator support layered on minui events.
        "twrp_input.cpp",
        "haptics.cpp",
        "resources.cpp",
        "force_feedback.cpp"
    ],
    whole_static_libs: ["libdrm"],
    shared_libs: [
        "libz",
        "libc",
        "libcutils",
        "libpng",
        "libutils",
        "libc++",
        "libcutils",
        "liblog",
        "libbase",
        "libsync",
	"libbinder_ndk"
    ],
}
