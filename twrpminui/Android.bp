bootstrap_go_package {
    name: "soong-libtwrpminui_defaults",
    pkgPath: "bootable/recovery/twrpminui",
    deps: [
        "soong",
        "soong-android",
        "soong-cc"
    ],
    srcs: [
        "libtwrpminui_defaults.go",
        "../soong/makevars.go"
    ],
    pluginFor: ["soong_build"]
}

libtwrpminui_defaults {
    name: "libtwrpminui_defaults"
}

cc_library_shared {
    name: "libtwrpminui",
    defaults: ["libtwrpminui_defaults", "twrp_defaults"],
    cflags: [
        "-DTWRES=\"/twres/\""
    ],
    export_include_dirs: [
        "include",
    ],
    include_dirs: [
        "bootable/recovery",
        "bootable/recovery/twrpinstall/include",
        "bootable/recovery/libpixelflinger/include",
        "bootable/recovery/gui/include"
    ],
    srcs: [
        "graphics.cpp",
        "graphics_fbdev.cpp",
        "resources.cpp",
        "truetype.cpp",
        "graphics_utils.cpp",
        "events.cpp"
    ],
    shared_libs: [
        "libft2",
        "libz",
        "libc",
        "libcutils",
        "libpng",
        "libutils",
        "libc++",
        "libcutils",
        "liblog",
        "libbase",
        "libsync",
	"libbinder_ndk"
    ],
    static_libs: ["libpixelflinger_twrp"]
}
