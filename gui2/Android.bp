package {
    default_applicable_licenses: ["bootable_recovery_license"],
}

// Keep GUI2-only vector artwork in this module. The generated header embeds
// the SVG in libgui2, independent of the legacy GUI theme resources.
genrule {
    name: "gui2_svg_assets_header",
    srcs: ["image/ic_*.svg"],
    out: ["gui2_svg_assets.h"],
    tool_files: ["generate_svg_header.py"],
    cmd: "python3 $(location generate_svg_header.py) $(in) > $(out)",
}

// LVGL-based recovery UI library.
cc_library_static {
    name: "libgui2",
    defaults: ["twrp_defaults"],
    cflags: [
        "-DLV_CONF_INCLUDE_SIMPLE",
        "-DLV_LVGL_H_INCLUDE_SIMPLE",
        "-Wno-error",
        "-Wno-unused-parameter",
        "-Wno-unused-function",
    ],
    local_include_dirs: ["."],
    export_include_dirs: ["."],
    include_dirs: [
        "bootable/recovery",
        "external/lvgl",
        "bootable/recovery/gui/include",
        "bootable/recovery/twrpperf/include",
    ],
    generated_headers: ["gui2_svg_assets_header"],
    srcs: [
        "app/gui2_loop.cpp",
        "app/gui2_lifecycle.cpp",
        "app/screen_actions.cpp",
        "components/icon.cpp",
        "components/choice_card.cpp",
        "components/apply_button.cpp",
        "components/slider_card.cpp",
        "components/check_row.cpp",
        "components/pattern_lock.cpp",
        "components/tab_bar.cpp",
        "components/quick_action_button.cpp",
        "components/setting_card.cpp",
        "components/section_label.cpp",
        "components/slider.cpp",
        "components/swipe_slider.cpp",
        "core/ui_helpers.cpp",
        "core/ui_metrics.cpp",
        "core/wheel_scroll.cpp",
        "core/ui_event_guard.cpp",
        "gui2.cpp",
        "gui2_svg_cache.cpp",
        "backend/rgb_to_i420.cpp",
        "backend/webm_vp8.cpp",
        "backend/status_backend.cpp",
        "i18n/*.cpp",
        "theme/font_manager.cpp",
        "gui2_display.cpp",
        "gui2_input.cpp",
        "pages/action_definitions.cpp",
        "pages/action_page.cpp",
        "pages/advanced_page.cpp",
        "pages/console_page.cpp",
        "pages/export_log_page.cpp",
        "pages/home_page.cpp",
        "pages/hardware_page.cpp",
        "pages/language_page.cpp",
        "pages/page_router.cpp",
        "pages/reboot_page.cpp",
        "pages/settings_page.cpp",
        "pages/backup_page.cpp",
        "pages/decrypt_page.cpp",
        "pages/mount_page.cpp",
        "pages/wipe_page.cpp",
        "pages/progress_page.cpp",
        "pages/timezone_page.cpp",
        "pages/timezone_logic.cpp",
        "shell/page_scaffold.cpp",
        "shell/quick_panel.cpp",
        "shell/confirm_dialog.cpp",
        "shell/quick_panel_controller.cpp",
        "shell/bottom_navigation.cpp",
        "shell/gui_shell_base.cpp",
        "shell/navigation_fade.cpp",
        "shell/mouse_cursor.cpp",
        "shell/page_host.cpp",
        "shell/status_bar.cpp",
        "shell/status_bar_controller.cpp",
        "shell/screen_feedback.cpp",
        "shell/screen_lock.cpp",
    ],
    static_libs: [
        "liblvgl_twrp",
        "libvpx",
        "libwebm_mkvmuxer",
        "libtwrpperf",
        "librecovery_utils",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libtwrpminui",
    ],
}
